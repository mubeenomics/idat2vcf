root = true

[{*.{sh,bash,py},tests/fixtures/bcftools}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Bundled logshuru keeps its upstream tab style.
[lib/logshuru/*.sh]
indent_style = tab
indent_size = tab
tab_width = 4
